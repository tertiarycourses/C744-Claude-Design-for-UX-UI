BT 1 0 0 1 2 176.4 Tm /F3 7.6 Tf 9.2 TL (<!doctype html>) Tj T* (<html lang="en">) Tj T* (<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">) Tj T* (<title>Community Wellness Booking</title><link rel="stylesheet" href="styles.css">) Tj T* (<main class="app">) Tj T* (  <header><p class="eyebrow">Community Wellness</p><h1>Book an appointment</h1><p id="status") Tj T* (    role="status">Choose a service and time.</p></header>) Tj T* (  <form id="booking" novalidate>) Tj T* (    <div class="field"><label for="service">Service</label><select id="service" required><option) Tj T* (      value="">Choose a service</option><option>Counselling</option><option>Nutrition) Tj T* (      consultation</option><option>Wellness check</option></select></div>) Tj T* (    <div class="field"><label for="time">Time</label><select id="time" required><option value="">Choose a) Tj T* (      time</option><option>10:00 AM</option><option>2:30 PM</option><option>4:00 PM</option></select></div>) Tj T* (    <div id="error" class="notice notice--error" role="alert" hidden></div>) Tj T* (    <button class="button button--primary" type="submit">Confirm booking</button>) Tj T* (  </form>) Tj T* (  <section id="confirmation" class="card" hidden><h2>Booking confirmed</h2><p>Your appointment has been) Tj T* (    saved.</p><button id="reset" class="button button--secondary">Book another</button></section>) Tj T* (</main><script src="app.js"></script>) Tj T* (</html>) Tj T* ET
