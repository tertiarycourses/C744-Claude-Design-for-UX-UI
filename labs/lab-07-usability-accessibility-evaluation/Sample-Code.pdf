%PreformattedPara
.043137 .070588 .12549 rg
BT 1 0 0 1 2 121.2 Tm /F3 7.6 Tf 9.2 TL (// Run in the browser console on the prototype.) Tj T* (const issues = [];) Tj T* (document.querySelectorAll\('button, input, select, a[href]'\).forEach\(\(el\) => {) Tj T* (  const style = getComputedStyle\(el\);) Tj T* (  const rect = el.getBoundingClientRect\(\);) Tj T* (  if \(rect.width < 44 || rect.height < 44\) issues.push\({type:'target-size',) Tj T* (    element:el.outerHTML.slice\(0,80\)}\);) Tj T* (  if \(style.outlineStyle === 'none'\) issues.push\({type:'verify-focus-visible',) Tj T* (    element:el.outerHTML.slice\(0,80\)}\);) Tj T* (}\);) Tj T* (document.querySelectorAll\('input,select'\).forEach\(\(el\) => {) Tj T* (  if \(!el.labels?.length\) issues.push\({type:'missing-label', id:el.id}\);) Tj T* (}\);) Tj T* (console.table\(issues\);) Tj T* ET
Q
