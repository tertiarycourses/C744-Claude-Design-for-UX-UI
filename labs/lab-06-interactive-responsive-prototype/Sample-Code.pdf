%PreformattedPara
.043137 .070588 .12549 rg
BT 1 0 0 1 2 250 Tm /F3 7.6 Tf 9.2 TL (const form = document.querySelector\('#booking'\);) Tj T* (const service = document.querySelector\('#service'\);) Tj T* (const time = document.querySelector\('#time'\);) Tj T* (const error = document.querySelector\('#error'\);) Tj T* (const status = document.querySelector\('#status'\);) Tj T* (const confirmation = document.querySelector\('#confirmation'\);) Tj T* (form.addEventListener\('submit', \(event\) => {) Tj T* (  event.preventDefault\(\);) Tj T* (  if \(!service.value || !time.value\) {) Tj T* (    error.hidden = false;) Tj T* (    error.textContent = 'Choose both a service and an available time.';) Tj T* (    \(!service.value ? service : time\).focus\(\);) Tj T* (    return;) Tj T* (  }) Tj T* (  if \(time.value === '2:30 PM'\) {) Tj T* (    error.hidden = false;) Tj T* (    error.textContent = 'That time is no longer available. Your service selection is preserved; choose) Tj T* (      another time.';) Tj T* (    time.focus\(\);) Tj T* (    return;) Tj T* (  }) Tj T* (  error.hidden = true; form.hidden = true; confirmation.hidden = false;) Tj T* (  status.textContent = `Confirmed: ${service.value} at ${time.value}.`;) Tj T* (}\);) Tj T* (document.querySelector\('#reset'\).addEventListener\('click', \(\) => {) Tj T* (  confirmation.hidden = true; form.hidden = false; form.reset\(\); status.textContent = 'Choose a service and) Tj T* (    time.'; service.focus\(\);) Tj T* (}\);) Tj T* ET
Q
